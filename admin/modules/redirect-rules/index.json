{
  "expandable": false,
  "headerActions": {
    "elements": [
      {
        "key": "reload",
        "ui": { "type": "button", "icon": "tabler-refresh", "color": "success", "rounded": true },
        "tooltip": "Refresh List",
        "action": "reload",
        "class": "ms-2"
      },
      {
        "key": "create",
        "ui": { "type": "button", "icon": "tabler-plus", "color": "primary", "rounded": "md" },
        "label": "New Redirect",
        "tooltip": "Send an old URL to its new home",
        "action": "navigate",
        "to": "/module/redirect-rules/create"
      }
    ]
  },
  "filters": {
    "elements": [
      {
        "ui": { "type": "field" },
        "key": "status",
        "label": "Status",
        "placeholder": "Select Status",
        "type": "select",
        "options": {
          "items": [
            { "title": "Active", "value": "active" },
            { "title": "Inactive", "value": "inactive" }
          ]
        }
      },
      {
        "ui": { "type": "field" },
        "key": "match_type",
        "label": "Match",
        "placeholder": "Select Match",
        "type": "select",
        "options": {
          "items": [
            { "title": "Exact path", "value": "exact" },
            { "title": "Path and everything under it", "value": "prefix" },
            { "title": "Pattern", "value": "regex" }
          ]
        }
      },
      {
        "ui": { "type": "field" },
        "key": "code",
        "label": "Type",
        "placeholder": "Select Type",
        "type": "select",
        "options": {
          "items": [
            { "title": "301 Permanent", "value": "301" },
            { "title": "302 Temporary", "value": "302" },
            { "title": "307 Temporary, same method", "value": "307" },
            { "title": "308 Permanent, same method", "value": "308" }
          ]
        }
      }
    ]
  },
  "elements": [
    { "ui": { "type": "display" }, "label": "ID", "key": "id", "sortable": true, "width": "60px" },
    { "ui": { "type": "display" }, "label": "From", "key": "from_path", "sortable": true, "searchable": true, "ellipsis": true },
    { "ui": { "type": "display" }, "label": "Query", "key": "query_match", "sortable": false, "searchable": true, "ellipsis": true },
    { "ui": { "type": "display" }, "label": "To", "key": "to_path", "sortable": true, "searchable": true, "ellipsis": true },
    { "ui": { "type": "display" }, "label": "Match", "key": "match_type", "sortable": true, "align": "center", "width": "110px", "type": "chip" },
    { "ui": { "type": "display" }, "label": "Code", "key": "code", "sortable": true, "align": "center", "width": "90px", "type": "chip" },
    { "ui": { "type": "display" }, "label": "Hits", "key": "hits", "sortable": true, "align": "center", "width": "90px" },
    { "ui": { "type": "display" }, "label": "Last Hit", "key": "last_hit_at", "sortable": true, "align": "center", "type": "datetime" },
    { "ui": { "type": "display" }, "label": "Status", "key": "status", "sortable": false, "align": "center", "type": "status" }
  ],
  "actions": {
    "elements": [
      "edit",
      {
        "key": "delete",
        "action": "delete",
        "ui": { "type": "button", "icon": "tabler-trash", "color": "error", "rounded": true },
        "params": {
          "confirm": true,
          "confirmText": "Delete this redirect? Visitors following the old URL will get the 404 page again."
        }
      }
    ],
    "class": "fit"
  }
}
